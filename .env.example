# Uygulama Ayarları
APP_NAME="lastikciariyorum"
# APP_ENV: 'production' veya 'development' olarak ayarlayın
APP_ENV=development
APP_DEBUG=false
APP_URL=https://www.lastikciariyorum.com
BASE_PATH=

# === PRODUCTION Veritabanı Ayarları (Canlı Sunucu) ===
PROD_DB_HOST=localhost
PROD_DB_NAME=your_production_database
PROD_DB_USER=your_production_user
PROD_DB_PASS=your_production_password
PROD_DB_CHARSET=utf8mb4

# === DEVELOPMENT Veritabanı Ayarları (Localhost/Test) ===
DEV_DB_HOST=localhost
DEV_DB_NAME=your_development_database
DEV_DB_USER=your_development_user
DEV_DB_PASS=your_development_password
DEV_DB_CHARSET=utf8mb4

# Mail Ayarları (SMTP)
MAIL_HOST=lastikciariyorum.com
MAIL_PORT=587
MAIL_USERNAME=info@lastikciariyorum.com
MAIL_PASSWORD=your_mail_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@lastikciariyorum.com
MAIL_FROM_NAME="Lastikciariyorum.com"
MAIL_CONTACT_TO=info@lastikciariyorum.com

# Oturum Ayarları
SESSION_LIFETIME=7200

# Sayfalama
ITEMS_PER_PAGE=12

# AI Ayarları (Anthropic Claude API)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
